// Geometry export only; SCUFF is not counted as a fourth solver.
// Gold must resolve to SCUFF's dispersive Gold material database.
// Its dielectric parameters must be matched before external comparison.
OBJECT rotor
    MESHFILE Rot_C4_TightSlot_N2_Ultra_High_theta_018p0_rotor.msh
    MATERIAL Gold
ENDOBJECT

OBJECT stator
    MESHFILE Rot_C4_TightSlot_N2_Ultra_High_theta_018p0_stator.msh
    MATERIAL Gold
ENDOBJECT
