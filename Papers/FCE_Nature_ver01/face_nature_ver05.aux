\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Multiscale Cantor force amplification and rotational switching across the six-step benchmark in vacuum ($\varepsilon _{\rm  bg}=1.0$).} \textbf  {a}, Single-tooth vertical interdigitation ($N=0$) across tooth tip elevation $z_{\rm  tip} \in [-115, -55]\text  { nm}$, showing open-slot repulsive force ($+\roundtwo  {0.7067}\text  { pN}$ at $z_{\rm  tip} = -100\text  { nm}$) and sign reversal to attraction ($\roundtwo  {-0.359635}\text  { pN}$) under symmetric overhang ($z_{\rm  tip} = -55\text  { nm}$). \textbf  {b}, Zero-bias rotational switching ($\theta = 0^\circ $ to $48^\circ $) of axial Casimir force $F_z(\theta )$ (left axis) and normalized landing-pad overlap fraction $A_{\rm  overlap}/A_{\rm  tooth}$ (right axis) across the $N=0$ baseline, tight-slot $N=2$, compact $N=2$, and seven-track $N=3$ Cantor clutches. \textbf  {c}, Progression across prefractal generations $N = 0 \to 3$ on the matched \texttt  {Standard} BEM mesh, reaching $+\roundtwo  {3.17743}\text  { pN}$ open-slot repulsive force ($4.5{}\times $ over $N=0$) and $\roundtwo  {-14.0388}\text  { pN}$ engaged attraction at $N=3$. \textbf  {d}, Comparison of $N=2$ (3-track) and $N=3$ (7-track) Cantor hierarchies against matched non-fractal control families (single wide tooth, 3-track and 7-track uniform periodic gratings, size-matched monotonic arrays, and randomly permuted 7-track control). \textbf  {e}, Active-tooth-area normalized repulsive force density $F_z/A_{\rm  tooth}$ across all evaluated $N=2$ and $N=3$ hierarchies and controls. \textbf  {f}, Active-only versus full-monolithic NEMS structural assemblies incorporating spider spokes, hub collars, and substrate trenches ($<3.3\%$ support crosstalk).}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:quantum_clutch_architecture_and_narrative}{{2}{6}{\textbf {Multiscale Cantor force amplification and rotational switching across the six-step benchmark in vacuum ($\varepsilon _{\rm bg}=1.0$).} \textbf {a}, Single-tooth vertical interdigitation ($N=0$) across tooth tip elevation $z_{\rm tip} \in [-115, -55]\text { nm}$, showing open-slot repulsive force ($+\roundtwo {\SingletoothTrackzeroBemThetathreeFZPn }\text { pN}$ at $z_{\rm tip} = -100\text { nm}$) and sign reversal to attraction ($\roundtwo {\SingletoothTrackzeroOverhangBemThetathreeFZPn }\text { pN}$) under symmetric overhang ($z_{\rm tip} = -55\text { nm}$). \textbf {b}, Zero-bias rotational switching ($\theta = 0^\circ $ to $48^\circ $) of axial Casimir force $F_z(\theta )$ (left axis) and normalized landing-pad overlap fraction $A_{\rm overlap}/A_{\rm tooth}$ (right axis) across the $N=0$ baseline, tight-slot $N=2$, compact $N=2$, and seven-track $N=3$ Cantor clutches. \textbf {c}, Progression across prefractal generations $N = 0 \to 3$ on the matched \texttt {Standard} BEM mesh, reaching $+\roundtwo {\FractalNthreeCantorseventrackBemThetathreeFZPn }\text { pN}$ open-slot repulsive force ($\FractalNthreeVsNzeroBemStdRatio {}\times $ over $N=0$) and $\roundtwo {\FractalNthreeCantorseventrackBemThetafoureightFZPn }\text { pN}$ engaged attraction at $N=3$. \textbf {d}, Comparison of $N=2$ (3-track) and $N=3$ (7-track) Cantor hierarchies against matched non-fractal control families (single wide tooth, 3-track and 7-track uniform periodic gratings, size-matched monotonic arrays, and randomly permuted 7-track control). \textbf {e}, Active-tooth-area normalized repulsive force density $F_z/A_{\rm tooth}$ across all evaluated $N=2$ and $N=3$ hierarchies and controls. \textbf {f}, Active-only versus full-monolithic NEMS structural assemblies incorporating spider spokes, hub collars, and substrate trenches ($<3.3\%$ support crosstalk)}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Discretization sensitivity, corner-rounding regularization, and cross-solver benchmarks in vacuum ($\varepsilon _{\rm  bg}=1.0$).} \textbf  {a}, Repulsive-state ($\theta = 3^\circ \text  {--}6^\circ $) surface-mesh refinement across \texttt  {Standard} ($1504{}$ panels), \texttt  {High} ($3120{}$ panels), and \texttt  {Ultra-High} ($6016{}$ panels) discretizations for $N=2$ ($3168{}$ and $6576{}$ panels for $N=3$) comparing sharp-edge ($r_{\rm  edge} = 0$) and lithographically rounded ($r_{\rm  edge} = 5\text  { nm}$) 3D Vector-Dyadic BEM and diagnostic 3D Scalar-Yukawa BEM (top), alongside the Cantor-to-uniform repulsive gain ratio $F_z^{\rm  Cantor}/F_z^{\rm  unif}$ across mesh tiers (bottom). \textbf  {b}, Attractive-state ($\theta = 18^\circ \text  {--}48^\circ $) boundary-element continuum extrapolations ($h = N_{\rm  panels}^{-1/2} \to 0$) compared against 4-pass inclusion--exclusion 3D FDTD MEEP benchmarks and Scalar-Yukawa High-mesh bounds. \textbf  {c}, Cross-solver sign and magnitude comparison (on a symmetric logarithmic scale) across 3D Vector-Dyadic BEM, 3D Scalar-Yukawa BEM, 4-pass 3D FDTD ($R=50$), and 1D Lifshitz--PFA across disengaged repulsive, transition, and engaged attractive rotor angles. \textbf  {d}, Imaginary-frequency Gauss--Legendre quadrature convergence across $n_\xi \in \{16, 24, 32, 40, 64\}$ ($\roundfour  {0.00242971}\%$ drift for $n_\xi \ge 24$, top) and fixed-standoff ($\delta _{\rm  box} = 10{}\text  { nm}$) 4-pass FDTD resolution scaling across $R \in \{40, 50, 60, 80\}$ ($\roundtwo  {3.1519}\%$ drift between $R=60$ and $R=80$, bottom).}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:quantum_clutch_3solver_verification}{{3}{7}{\textbf {Discretization sensitivity, corner-rounding regularization, and cross-solver benchmarks in vacuum ($\varepsilon _{\rm bg}=1.0$).} \textbf {a}, Repulsive-state ($\theta = 3^\circ \text {--}6^\circ $) surface-mesh refinement across \texttt {Standard} ($\RotCfourTightslotNtwoStandardThetaZerozerosixpzeroPanelCount {}$ panels), \texttt {High} ($\RotCfourTightslotNtwoHighThetaZerozerosixpzeroPanelCount {}$ panels), and \texttt {Ultra-High} ($\RotCfourTightslotNtwoUltraHighThetaZerozerosixpzeroPanelCount {}$ panels) discretizations for $N=2$ ($\RotConezeroFractalNthreeStandardThetaZerozerothreepzeroPanelCount {}$ and $\RotConezeroFractalNthreeHighThetaZerozerothreepzeroPanelCount {}$ panels for $N=3$) comparing sharp-edge ($r_{\rm edge} = 0$) and lithographically rounded ($r_{\rm edge} = 5\text { nm}$) 3D Vector-Dyadic BEM and diagnostic 3D Scalar-Yukawa BEM (top), alongside the Cantor-to-uniform repulsive gain ratio $F_z^{\rm Cantor}/F_z^{\rm unif}$ across mesh tiers (bottom). \textbf {b}, Attractive-state ($\theta = 18^\circ \text {--}48^\circ $) boundary-element continuum extrapolations ($h = N_{\rm panels}^{-1/2} \to 0$) compared against 4-pass inclusion--exclusion 3D FDTD MEEP benchmarks and Scalar-Yukawa High-mesh bounds. \textbf {c}, Cross-solver sign and magnitude comparison (on a symmetric logarithmic scale) across 3D Vector-Dyadic BEM, 3D Scalar-Yukawa BEM, 4-pass 3D FDTD ($R=50$), and 1D Lifshitz--PFA across disengaged repulsive, transition, and engaged attractive rotor angles. \textbf {d}, Imaginary-frequency Gauss--Legendre quadrature convergence across $n_\xi \in \{16, 24, 32, 40, 64\}$ ($\roundfour {\BemConvNxiDriftPct }\%$ drift for $n_\xi \ge 24$, top) and fixed-standoff ($\delta _{\rm box} = \MeepFixedboxMarginNm {}\text { nm}$) 4-pass FDTD resolution scaling across $R \in \{40, 50, 60, 80\}$ ($\roundtwo {\MeepFixedboxRsixzeroToReightzeroDriftPct }\%$ drift between $R=60$ and $R=80$, bottom)}{figure.3}{}}
\newlabel{sec:log_periodicity_clutch}{{1}{9}{Wavenumber and stroke log-periodicity}{section*.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Spectral wavenumber partitioning and multi-stage vertical stroke response in the 3D Cantor clutch in vacuum ($\varepsilon _{\rm  bg}=1.0$).} \textbf  {a}, Normalized 3D Vector-Dyadic BEM diagnostic radial-wall coupling norm $w_m(\kappa )/\max $ and exact signed Casimir force integrand decomposition $\DOTSB \sum@ \slimits@ _{m=1}^{3}\kappa f_{z,m}(\kappa )/\max $ (peak $+0.37\text  { pN}$, trace decomposition residual $<10^{-16}\text  { pN}\cdot \mu \text  {m}$) across logarithmic imaginary wavenumber $\ln (\kappa \cdot 1\ \mu \text  {m})$ for the coplanar third-generation seven-track Cantor ring ($N=3$, $b=3$, radial clearances $g_{r,1}=135\text  { nm}$, $g_{r,2}=45\text  { nm}$, $g_{r,3}=15\text  { nm}$; spectral peaks at $\ln \kappa = \roundtwo  {2.70805}, \roundtwo  {3.39883}, \text  {and } \roundtwo  {3.85934}$) compared against the three-track uniform periodic control. Dashed vertical lines mark the inverse radial clearance scales $\kappa = 1/g_{r,m}$. \textbf  {b}, Scale-compensated repulsive force $|z_{\rm  rotor}|^2 F_z(z_{\rm  rotor})$ swept across $36$ logarithmically spaced vertical stroke depths $|z_{\rm  rotor}| \in [25, 450]\text  { nm}$ ($\ln (|z_{\rm  rotor}|/\ell _3) \in [-0.47, 2.42]$) in a three-generation $(r,z)$-stepped Cantor clutch ($b=2.5{}$, geometrically spaced stator stage elevations $|z_{{\rm  stage},m}| \in \{250, 100, 40\}\text  { nm}$) versus a non-geometric three-stage control with linearly spaced elevations ($|z_{\rm  stage}| \in \{250, 145, 40\}\text  { nm}$) and a single-scale three-track uniform control ($|z_{\rm  stage}| = 100\text  { nm}$). Dotted vertical lines indicate the designed logarithmic stage intervals $\Delta \ln |z| = \ln b = \roundthree  {0.916291}$. \textbf  {c}, Detrended modulation $\delta (|z|^2 F_z)$ and $95\%$ regression confidence band from a simultaneous joint quadratic-plus-harmonic least-squares fit to Eq.~\eqref  {eq:fourier_running} at the geometric scaling frequency $\omega _1 = 2\pi /\ln b = \roundtwo  {6.8572}$ ($R^2 = \roundtwo  {0.529}$, $F = \roundtwo  {7.9214}$, $p = 1.9 \times 10^{-4}$, $\Delta \mathrm  {AIC} = \roundone  {-18.5828}$, $\Delta \mathrm  {BIC} = \roundone  {-12.2487}$ for the stepped Cantor clutch, versus $R^2 = \roundtwo  {0.176312}$, $\Delta \mathrm  {AIC} = +\roundone  {1.35448}$ for the linear three-stage control and $R^2 = \roundtwo  {0.0141241}$ for the single-scale uniform control). Inset: unconstrained free-frequency Lomb--Scargle variance-explained spectrum $R^2(\omega )$ swept across $\omega \in [1.0, 14.0]$, recovering $\hat  {\omega }_1 = \roundtwo  {6.45848} \pm \roundtwo  {0.345342}$ and scale factor $\hat  {b} = \exp (2\pi /\hat  {\omega }_1) = \roundtwo  {2.6455} \pm \roundtwo  {0.138461}$ ($95\%\text  { CI}$, peak $R^2(\hat  {\omega }_1) = \roundtwo  {0.586987}$).}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:clutch_log_periodicity}{{4}{10}{\textbf {Spectral wavenumber partitioning and multi-stage vertical stroke response in the 3D Cantor clutch in vacuum ($\varepsilon _{\rm bg}=1.0$).} \textbf {a}, Normalized 3D Vector-Dyadic BEM diagnostic radial-wall coupling norm $w_m(\kappa )/\max $ and exact signed Casimir force integrand decomposition $\sum _{m=1}^{3}\kappa f_{z,m}(\kappa )/\max $ (peak $+0.37\text { pN}$, trace decomposition residual $<10^{-16}\text { pN}\cdot \mu \text {m}$) across logarithmic imaginary wavenumber $\ln (\kappa \cdot 1\ \mu \text {m})$ for the coplanar third-generation seven-track Cantor ring ($N=3$, $b=3$, radial clearances $g_{r,1}=135\text { nm}$, $g_{r,2}=45\text { nm}$, $g_{r,3}=15\text { nm}$; spectral peaks at $\ln \kappa = \roundtwo {\LogperLnKPeakLone }, \roundtwo {\LogperLnKPeakLtwo }, \text {and } \roundtwo {\LogperLnKPeakLthree }$) compared against the three-track uniform periodic control. Dashed vertical lines mark the inverse radial clearance scales $\kappa = 1/g_{r,m}$. \textbf {b}, Scale-compensated repulsive force $|z_{\rm rotor}|^2 F_z(z_{\rm rotor})$ swept across $36$ logarithmically spaced vertical stroke depths $|z_{\rm rotor}| \in [25, 450]\text { nm}$ ($\ln (|z_{\rm rotor}|/\ell _3) \in [-0.47, 2.42]$) in a three-generation $(r,z)$-stepped Cantor clutch ($b=\LogperSteppedRzBScale {}$, geometrically spaced stator stage elevations $|z_{{\rm stage},m}| \in \{250, 100, 40\}\text { nm}$) versus a non-geometric three-stage control with linearly spaced elevations ($|z_{\rm stage}| \in \{250, 145, 40\}\text { nm}$) and a single-scale three-track uniform control ($|z_{\rm stage}| = 100\text { nm}$). Dotted vertical lines indicate the designed logarithmic stage intervals $\Delta \ln |z| = \ln b = \roundthree {\LogperSteppedRzLnB }$. \textbf {c}, Detrended modulation $\delta (|z|^2 F_z)$ and $95\%$ regression confidence band from a simultaneous joint quadratic-plus-harmonic least-squares fit to Eq.~\eqref {eq:fourier_running} at the geometric scaling frequency $\omega _1 = 2\pi /\ln b = \roundtwo {\LogperSteppedRzOmegaone }$ ($R^2 = \roundtwo {\LogperSteppedRzRtwo }$, $F = \roundtwo {\LogperSteppedRzFstatCantor }$, $p = 1.9 \times 10^{-4}$, $\Delta \mathrm {AIC} = \roundone {\LogperSteppedRzDeltaAicCantor }$, $\Delta \mathrm {BIC} = \roundone {\LogperSteppedRzDeltaBicCantor }$ for the stepped Cantor clutch, versus $R^2 = \roundtwo {\LogperSteppedRzRtwoLinear }$, $\Delta \mathrm {AIC} = +\roundone {\LogperSteppedRzDeltaAicLinear }$ for the linear three-stage control and $R^2 = \roundtwo {\LogperSteppedRzRtwoUniform }$ for the single-scale uniform control). Inset: unconstrained free-frequency Lomb--Scargle variance-explained spectrum $R^2(\omega )$ swept across $\omega \in [1.0, 14.0]$, recovering $\hat {\omega }_1 = \roundtwo {\LogperFreeOmegaoneCantor } \pm \roundtwo {\LogperFreeOmegaoneCininefiveHalfCantor }$ and scale factor $\hat {b} = \exp (2\pi /\hat {\omega }_1) = \roundtwo {\LogperFreeBHatCantor } \pm \roundtwo {\LogperFreeBHatCininefiveHalfCantor }$ ($95\%\text { CI}$, peak $R^2(\hat {\omega }_1) = \roundtwo {\LogperFreeRtwoPeakCantor }$)}{figure.4}{}}
\newlabel{sec:experimental}{{1}{11}{Room-temperature mechanical stability}{section*.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Room-temperature ($T=300{}\text  { K}$) thermal dispersion, electrostatic bias thresholds, flexure scaling, fabrication tolerances, rotational energy/torque, and thermomechanical lock-in SNR in vacuum ($\varepsilon _{\rm  bg}=1.0$).} \textbf  {a}, Thermal Matsubara dispersion across ideal PEC ($0\text  { K}$), Drude gold ($0\text  { K}$), and room-temperature Drude gold ($300\text  { K}$) for the stepped $(r,z)$ $N=2$ Cantor ring and compact $N=2$ variant on the \texttt  {Standard} BEM mesh. \textbf  {b}, Net repulsive restoring force $F_{z,\rm  net}$ across residual root-mean-square electrostatic bias voltages $V_{\rm  rms} \in [0, 100]\text  { mV}$, showing the critical uniform-bias thresholds ($V_{\rm  crit} = \roundone  {90.2392}\text  { mV}$ and $\roundone  {94.1128}\text  { mV}$) and the $<5\text  { mV}$ Kelvin-probe nulled mean-potential regime. \textbf  {c}, Destabilizing radial Earnshaw Casimir stiffness $|k_{r,\rm  Casimir}|$ compared on a logarithmic scale against the stabilizing four-spoke single-crystal $\text  {Si}\langle 110\rangle $ radial flexure stiffness $k_{r,\rm  mech}$ ($E_Y = \scinum  {1.69e+11}\text  { Pa}$) across isometric transducer (Regime~I), nanometre-stroke (Regime~II), and contact-release clutch (Regime~III) suspensions. \textbf  {d}, Room-temperature open-slot repulsive force $F_z(3^\circ )$ and rotational switching swing $\Delta F_z$ across critical-dimension tooth-width etch biases $\Delta w_{\rm  tooth} \in [-10, +10]\text  { nm}$ and EBL corner rounding $r_{\rm  edge} = 5\text  {--}10\text  { nm}$. \textbf  {e}, 3D Vector-Dyadic BEM rotational Casimir interaction energy landscape $\Delta E_C(\theta ) = E_C(\theta ) - E_C(0^\circ )$ (left axis) and axial-switching Casimir torque $\tau _\theta (\theta ) = -\partial E_C(\theta )/\partial \theta $ (right axis) across $\theta \in [0^\circ , 48^\circ ]$, highlighting the $\theta =18^\circ \text  {--}21^\circ $ sidewall-crossing potential well, state-to-state switching work $W_{\rm  switch}(48^\circ \!\to \!3^\circ ) = 0.23\text  { eV}$, and peak torque $|\tau _\theta |_{\max } = 285\text  {--}332\text  { pN}\cdot \text  {nm}$. \textbf  {f}, Room-temperature ($300\text  { K}$) thermomechanical lock-in force signal-to-noise ratio $\mathrm  {SNR}(\tau ) = F_{z,300\rm  K}^{\rm  rep}/\delta F_{\rm  th}(\tau )$ versus integration time $\tau \in [10^{-3}, 10^2]\text  { s}$ across Regimes~I--III for ultra-high-vacuum quality factors $Q = 10^4$ (solid) and $Q = 10^5$ (dashed), showing $\mathrm  {SNR}(1\text  { s}) = 1{,}155\text  {--}1{,}307$ in Regime~I ($f_0 = 2{,}001\text  { kHz}$, $\delta z_{\rm  th} = 0.18\text  { nm}$) and $\mathrm  {SNR} > 10^2$ across all regimes.}}{12}{figure.5}\protected@file@percent }
\newlabel{fig:nature_feasibility_stability}{{5}{12}{\textbf {Room-temperature ($T=\NatureRotCeightCompactNtwoCdToleranceTemperatureK {}\text { K}$) thermal dispersion, electrostatic bias thresholds, flexure scaling, fabrication tolerances, rotational energy/torque, and thermomechanical lock-in SNR in vacuum ($\varepsilon _{\rm bg}=1.0$).} \textbf {a}, Thermal Matsubara dispersion across ideal PEC ($0\text { K}$), Drude gold ($0\text { K}$), and room-temperature Drude gold ($300\text { K}$) for the stepped $(r,z)$ $N=2$ Cantor ring and compact $N=2$ variant on the \texttt {Standard} BEM mesh. \textbf {b}, Net repulsive restoring force $F_{z,\rm net}$ across residual root-mean-square electrostatic bias voltages $V_{\rm rms} \in [0, 100]\text { mV}$, showing the critical uniform-bias thresholds ($V_{\rm crit} = \roundone {\NatureCantorNtwoHybridrzPatchPotentialVCritMv }\text { mV}$ and $\roundone {\NatureRotCeightCompactNtwoPatchPotentialVCritMv }\text { mV}$) and the $<5\text { mV}$ Kelvin-probe nulled mean-potential regime. \textbf {c}, Destabilizing radial Earnshaw Casimir stiffness $|k_{r,\rm Casimir}|$ compared on a logarithmic scale against the stabilizing four-spoke single-crystal $\text {Si}\langle 110\rangle $ radial flexure stiffness $k_{r,\rm mech}$ ($E_Y = \scinum {\NatureRotCeightCompactNtwoLateralStabilityEYPa }\text { Pa}$) across isometric transducer (Regime~I), nanometre-stroke (Regime~II), and contact-release clutch (Regime~III) suspensions. \textbf {d}, Room-temperature open-slot repulsive force $F_z(3^\circ )$ and rotational switching swing $\Delta F_z$ across critical-dimension tooth-width etch biases $\Delta w_{\rm tooth} \in [-10, +10]\text { nm}$ and EBL corner rounding $r_{\rm edge} = 5\text {--}10\text { nm}$. \textbf {e}, 3D Vector-Dyadic BEM rotational Casimir interaction energy landscape $\Delta E_C(\theta ) = E_C(\theta ) - E_C(0^\circ )$ (left axis) and axial-switching Casimir torque $\tau _\theta (\theta ) = -\partial E_C(\theta )/\partial \theta $ (right axis) across $\theta \in [0^\circ , 48^\circ ]$, highlighting the $\theta =18^\circ \text {--}21^\circ $ sidewall-crossing potential well, state-to-state switching work $W_{\rm switch}(48^\circ \!\to \!3^\circ ) = 0.23\text { eV}$, and peak torque $|\tau _\theta |_{\max } = 285\text {--}332\text { pN}\cdot \text {nm}$. \textbf {f}, Room-temperature ($300\text { K}$) thermomechanical lock-in force signal-to-noise ratio $\mathrm {SNR}(\tau ) = F_{z,300\rm K}^{\rm rep}/\delta F_{\rm th}(\tau )$ versus integration time $\tau \in [10^{-3}, 10^2]\text { s}$ across Regimes~I--III for ultra-high-vacuum quality factors $Q = 10^4$ (solid) and $Q = 10^5$ (dashed), showing $\mathrm {SNR}(1\text { s}) = 1{,}155\text {--}1{,}307$ in Regime~I ($f_0 = 2{,}001\text { kHz}$, $\delta z_{\rm th} = 0.18\text { nm}$) and $\mathrm {SNR} > 10^2$ across all regimes}{figure.5}{}}
