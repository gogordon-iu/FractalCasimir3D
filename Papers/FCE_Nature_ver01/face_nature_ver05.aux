\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Room-temperature ($T = 300{}\text  { K}$) NEMS feasibility, discretization-bounded pull-in thresholds, multi-regime $\text  {Si}\langle 110\rangle $ flexure stroke scaling, and lithographic tolerances in true vacuum ($\varepsilon _{\rm  bg}=1.0$).} Comparison of thermal Matsubara dispersion, capacitance-gradient patch-voltage thresholds $V_{\rm  crit}$, four-spoke single-crystal $\text  {Si}\langle 110\rangle $ suspension designs ($E_Y = \scinum  {1.69e+11}\text  { Pa}$) across three operational stroke regimes bounded across (a) Standard sharp-edge BEM ($N_{\rm  panels}=1{,}504$), (b) $r_{\rm  edge}=5\text  { nm}$ rounded-edge Ultra-High BEM ($N_{\rm  panels}=6{,}016$, for $\theta _{\rm  off}=3^\circ $ repulsive metrics and Ultra-High BEM for $\theta =48^\circ $ pull-in metrics), and (c) continuum-extrapolated ($N_{\rm  panels}\to \infty $) forces, plus EBL corner rounding ($r_{\rm  edge}$) and critical-dimension tooth-width biases ($\Delta w_{\rm  tooth}$) for \texttt  {Cantor\_N2\_HybridRZ} and \texttt  {Rot\_C8\_Compact\_N2}.}}{28}{table.ext.3}\protected@file@percent }
