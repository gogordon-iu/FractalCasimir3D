\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Three-dimensional geometric atlas across all 12 evaluated cavity constellations in vacuum ($\varepsilon _{\rm  bg}=1.0$).} Individual 3D cutaway portraits and radial cross-section $(r, z)$ geometry bars across all 12 constellations: \textbf  {a}, $N=0$ symmetric overhang (\texttt  {SingleTooth\_Track0}, $z_{\rm  tip} = -55\text  { nm}$); \textbf  {b}, $N=0$ deep interdigitation (\texttt  {SingleTooth\_Track0}, $z_{\rm  tip} = -100\text  { nm}$); \textbf  {c}, $N=1$ fundamental Cantor slot (\texttt  {Fractal\_N1\_FundRing}); \textbf  {d}, single wide tooth control (\texttt  {Ctrl\_SingleWide}); \textbf  {e}, uniform periodic grating control (\texttt  {Ctrl\_UniformPeriodic}); \textbf  {f}, size-matched monotonic array control (\texttt  {Ctrl\_SizeMatched\_Monotonic}); \textbf  {g}, uniform-depth $N=2$ Cantor ring (\texttt  {Cantor\_N2\_FlatZ}, $H_1 = H_2 = 100\text  { nm}$); \textbf  {h}, $(r,z)$-scaled $N=2$ Cantor ring (\texttt  {Cantor\_N2\_HybridRZ}, $H_1 = 100\text  { nm}$, $H_2 = 90\text  { nm}$); \textbf  {i}, compact $N=2$ rotational variant (\texttt  {Rot\_C8\_Compact\_N2}); \textbf  {j}, tight-slot $N=2$ rotational variant (\texttt  {Rot\_C4\_TightSlot\_N2}); \textbf  {k}, third-generation seven-track Cantor ring ($N=3$, \texttt  {Fractal\_N3\_Cantor7Track}, $28$ teeth); and \textbf  {l}, full-monolithic $N=2$ and $N=3$ structural assemblies incorporating four radial spider spokes, hub collars, and lower substrate isolation trenches.}}{26}{figure.ext.1}\protected@file@percent }
\newlabel{fig:all_constellations_blender}{{1}{26}{\textbf {Three-dimensional geometric atlas across all 12 evaluated cavity constellations in vacuum ($\varepsilon _{\rm bg}=1.0$).} Individual 3D cutaway portraits and radial cross-section $(r, z)$ geometry bars across all 12 constellations: \textbf {a}, $N=0$ symmetric overhang (\texttt {SingleTooth\_Track0}, $z_{\rm tip} = -55\text { nm}$); \textbf {b}, $N=0$ deep interdigitation (\texttt {SingleTooth\_Track0}, $z_{\rm tip} = -100\text { nm}$); \textbf {c}, $N=1$ fundamental Cantor slot (\texttt {Fractal\_N1\_FundRing}); \textbf {d}, single wide tooth control (\texttt {Ctrl\_SingleWide}); \textbf {e}, uniform periodic grating control (\texttt {Ctrl\_UniformPeriodic}); \textbf {f}, size-matched monotonic array control (\texttt {Ctrl\_SizeMatched\_Monotonic}); \textbf {g}, uniform-depth $N=2$ Cantor ring (\texttt {Cantor\_N2\_FlatZ}, $H_1 = H_2 = 100\text { nm}$); \textbf {h}, $(r,z)$-scaled $N=2$ Cantor ring (\texttt {Cantor\_N2\_HybridRZ}, $H_1 = 100\text { nm}$, $H_2 = 90\text { nm}$); \textbf {i}, compact $N=2$ rotational variant (\texttt {Rot\_C8\_Compact\_N2}); \textbf {j}, tight-slot $N=2$ rotational variant (\texttt {Rot\_C4\_TightSlot\_N2}); \textbf {k}, third-generation seven-track Cantor ring ($N=3$, \texttt {Fractal\_N3\_Cantor7Track}, $28$ teeth); and \textbf {l}, full-monolithic $N=2$ and $N=3$ structural assemblies incorporating four radial spider spokes, hub collars, and lower substrate isolation trenches}{figure.ext.1}{}}
