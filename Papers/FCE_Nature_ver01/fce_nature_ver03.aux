\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Multi-resolution and three-solver verification of rotational switching in true vacuum ($\varepsilon _{\rm  bg}=1.0$).} Axial Casimir forces $F_z$ (in pN) across \texttt  {Standard} ($1504{}$ panels for $N=2$; $3168{}$ for $N=3$), \texttt  {High} ($3120{}$ panels for $N=2$; $6576{}$ for $N=3$), and \texttt  {Ultra-High} ($6016{}$ panels for $N=2$) surface discretizations in 3D Vector-Dyadic BEM, alongside 3D Scalar-Yukawa BEM (\texttt  {High}) and 4-pass inclusion--exclusion 3D FDTD MEEP ($R=50$, $\Delta x = 20\text  { nm}$). Each 4-pass FDTD evaluation integrates $9{}$ DCT moments per tooth per pass across $4{}$ passes ($108{}/432{}$ per-pass/total moments for $N=2$ and $252{}/1008{}$ for $N=3$).}}{24}{table.2}\protected@file@percent }
