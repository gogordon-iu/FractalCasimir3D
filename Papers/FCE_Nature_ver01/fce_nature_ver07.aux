\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Multi-resolution BEM convergence, corner-rounding regularization ($r_{\rm  edge}=5\text  { nm}$), and qualitative 4-pass FDTD sign checks of rotational switching in vacuum ($\varepsilon _{\rm  bg}=1.0$).} Axial Casimir forces $F_z$ (in pN) across Standard ($1504{}$ panels for $N=2$; $3168{}$ for 7-track $N=3$; $6{,}784$ panels across 4 sectors for 12-sub-tooth 3D recursive $N=3$), High ($3120{}$ panels for $N=2$; $6576{}$ for $N=3$), and Ultra-High ($6016{}$ panels for $N=2$) surface discretizations in 3D Vector-Dyadic BEM, alongside independent qualitative sign checks from diagnostic 3D Scalar-Yukawa BEM (High) and 4-pass inclusion--exclusion 3D FDTD MEEP ($R=50$, $\Delta x = 20\text  { nm}$). Each 4-pass FDTD evaluation integrates $9{}$ DCT moments per tooth per pass across $4{}$ passes ($108{}/432{}$ per-pass/total moments for $N=2$ and $252{}/1008{}$ for $N=3$).}}{46}{table.ext.3}\protected@file@percent }
