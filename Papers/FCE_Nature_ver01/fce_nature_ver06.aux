\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Radial Cantor subdivision with generation-aligned azimuthal splitting and axial stepping: $2^3$ $(r, \theta , z)$ factorial ablation, exact $b=3$ scaling variants, matched 7-tooth and 12-tooth non-fractal controls, and 3-tier nested physical-resolution convergence in vacuum ($\varepsilon _{\rm  bg}=1.0$).} All configurations span the identical $N=3$ annulus $R \in [0.3{}, 1.65{}]\ \mu \text  {m}$ with invariant recessed stator landing-pad elevation $z_{\rm  pad,top} = -115\text  { nm}$, azimuthal tooth envelope $\le 28^\circ $ inside $36^\circ $ stator apertures, minimum tooth width $\ge 20.0\text  { nm}$, minimum radial clearance $\ge 15{}\text  { nm}$, and minimum axial clearance $\ge 15{}\text  { nm}$, evaluated at $\theta = 3^\circ $ in 3D Vector-Dyadic BEM. Upper panel: equal-panel-count Standard sharp-edge ($r_{\rm  edge}=0$, $n_\xi = 24$) benchmark listing the upgrade tuple $(u_r, u_\theta , u_z)$, primary slots / stator sub-slots / internal stator sub-ribs / rotor sub-teeth / azimuthal lobes per $90^\circ $ sector, active tooth top-face area $A_{\rm  tooth}$, fundamental-sector BEM panels (rotor / stator), disengaged repulsive axial force $F_z(3^\circ )$, area-normalized force density $F_z/A_{\rm  tooth}$, circumference-normalized force density $\DOTSB \sum@ \slimits@ _k F_{z,k}/(2\pi R_k)$, and wavenumber band modulation amplitude, together with four exact common-ratio $b=3$ angular and axial scaling variants. Lower panel: 3-tier nested physical-resolution convergence (Tier~1 Standard Physical, Tier~2 High Physical, Tier~3 Ultra-High Physical, enforcing matched local panel size, edge resolution, gap resolution, and panel aspect ratio $\overline  {\mathrm  {AR}} \approx 5.1\text  {--}6.8$) evaluated at physical lithographic corner radii $r_{\rm  edge} = 5\text  { nm}$ and $r_{\rm  edge} = 10\text  { nm}$.}}{38}{table.ext.2}\protected@file@percent }
\newlabel{tab:unified_3d_fractal_factorial}{{2}{38}{\textbf {Radial Cantor subdivision with generation-aligned azimuthal splitting and axial stepping: $2^3$ $(r, \theta , z)$ factorial ablation, exact $b=3$ scaling variants, matched 7-tooth and 12-tooth non-fractal controls, and 3-tier nested physical-resolution convergence in vacuum ($\varepsilon _{\rm bg}=1.0$).} All configurations span the identical $N=3$ annulus $R \in [\FractalNthreeCantorseventrackRInUm {}, \FractalNthreeCantorseventrackROutUm {}]\ \mu \text {m}$ with invariant recessed stator landing-pad elevation $z_{\rm pad,top} = -115\text { nm}$, azimuthal tooth envelope $\le 28^\circ $ inside $36^\circ $ stator apertures, minimum tooth width $\ge 20.0\text { nm}$, minimum radial clearance $\ge \NthreeBlenderAuditMinRadialClearanceNm {}\text { nm}$, and minimum axial clearance $\ge \NthreeBlenderAuditMinAxialClearanceNm {}\text { nm}$, evaluated at $\theta = 3^\circ $ in 3D Vector-Dyadic BEM. Upper panel: equal-panel-count Standard sharp-edge ($r_{\rm edge}=0$, $n_\xi = 24$) benchmark listing the upgrade tuple $(u_r, u_\theta , u_z)$, primary slots / stator sub-slots / internal stator sub-ribs / rotor sub-teeth / azimuthal lobes per $90^\circ $ sector, active tooth top-face area $A_{\rm tooth}$, fundamental-sector BEM panels (rotor / stator), disengaged repulsive axial force $F_z(3^\circ )$, area-normalized force density $F_z/A_{\rm tooth}$, circumference-normalized force density $\sum _k F_{z,k}/(2\pi R_k)$, and wavenumber band modulation amplitude, together with four exact common-ratio $b=3$ angular and axial scaling variants. Lower panel: 3-tier nested physical-resolution convergence (Tier~1 Standard Physical, Tier~2 High Physical, Tier~3 Ultra-High Physical, enforcing matched local panel size, edge resolution, gap resolution, and panel aspect ratio $\overline {\mathrm {AR}} \approx 5.1\text {--}6.8$) evaluated at physical lithographic corner radii $r_{\rm edge} = 5\text { nm}$ and $r_{\rm edge} = 10\text { nm}$}{table.ext.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Multi-resolution BEM convergence, corner-rounding regularization ($r_{\rm  edge}=5\text  { nm}$), and qualitative 4-pass FDTD sign checks of rotational switching in vacuum ($\varepsilon _{\rm  bg}=1.0$).} Axial Casimir forces $F_z$ (in pN) across Standard ($1504{}$ panels for $N=2$; $3168{}$ for 7-track $N=3$; $6{,}784$ panels across 4 sectors for 12-sub-tooth 3D recursive $N=3$), High ($3120{}$ panels for $N=2$; $6576{}$ for $N=3$), and Ultra-High ($6016{}$ panels for $N=2$) surface discretizations in 3D Vector-Dyadic BEM, alongside independent qualitative sign checks from diagnostic 3D Scalar-Yukawa BEM (High) and 4-pass inclusion--exclusion 3D FDTD MEEP ($R=50$, $\Delta x = 20\text  { nm}$). Each 4-pass FDTD evaluation integrates $9{}$ DCT moments per tooth per pass across $4{}$ passes ($108{}/432{}$ per-pass/total moments for $N=2$ and $252{}/1008{}$ for $N=3$).}}{39}{table.ext.3}\protected@file@percent }
\newlabel{tab:quantum_clutch}{{3}{39}{\textbf {Multi-resolution BEM convergence, corner-rounding regularization ($r_{\rm edge}=5\text { nm}$), and qualitative 4-pass FDTD sign checks of rotational switching in vacuum ($\varepsilon _{\rm bg}=1.0$).} Axial Casimir forces $F_z$ (in pN) across Standard ($\RotCfourTightslotNtwoStandardThetaZerozerosixpzeroPanelCount {}$ panels for $N=2$; $\RotConezeroFractalNthreeStandardThetaZerozerothreepzeroPanelCount {}$ for 7-track $N=3$; $6{,}784$ panels across 4 sectors for 12-sub-tooth 3D recursive $N=3$), High ($\RotCfourTightslotNtwoHighThetaZerozerosixpzeroPanelCount {}$ panels for $N=2$; $\RotConezeroFractalNthreeHighThetaZerozerothreepzeroPanelCount {}$ for $N=3$), and Ultra-High ($\RotCfourTightslotNtwoUltraHighThetaZerozerosixpzeroPanelCount {}$ panels for $N=2$) surface discretizations in 3D Vector-Dyadic BEM, alongside independent qualitative sign checks from diagnostic 3D Scalar-Yukawa BEM (High) and 4-pass inclusion--exclusion 3D FDTD MEEP ($R=50$, $\Delta x = 20\text { nm}$). Each 4-pass FDTD evaluation integrates $\FdtdMomentsPerToothPerPass {}$ DCT moments per tooth per pass across $\FdtdInclusionExclusionPasses {}$ passes ($\NaturemeeptaskzerozerofourMomentsPerConfig {}/\NaturemeeptaskzerozerofourTotalMoments {}$ per-pass/total moments for $N=2$ and $\RotConezeroFractalNthreeMomentsPerConfig {}/\RotConezeroFractalNthreeTotalMoments {}$ for $N=3$)}{table.ext.3}{}}
