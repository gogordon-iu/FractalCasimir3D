\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Room-temperature ($T = 300{}\text  { K}$) NEMS mechanical feasibility, discretization-bounded pull-in thresholds, multi-regime $\text  {Si}\langle 110\rangle $ flexure stroke scaling, and lithographic tolerances in vacuum ($\varepsilon _{\rm  bg}=1.0$).} Comparison of thermal Matsubara dispersion, capacitance-gradient patch-voltage thresholds $V_{\rm  crit}$, four-spoke single-crystal $\text  {Si}\langle 110\rangle $ suspension designs ($E_Y = \scinum  {1.69e+11}\text  { Pa}$) across three operational stroke regimes bounded across (a) Standard sharp-edge BEM ($N_{\rm  panels}=1504{}$ for $N=2$; $6{,}784$ for \texttt  {F3-111}), (b) $r_{\rm  edge}=5\text  { nm}$ rounded-edge BEM ($N_{\rm  panels}=6016{}$ Ultra-High for $N=2$; Standard per-sub-tooth density for \texttt  {F3-111}), and (c) continuum-extrapolated ($N_{\rm  panels}\to \infty $) forces, plus EBL corner rounding ($r_{\rm  edge}$) and critical-dimension tooth-width biases ($\Delta w_{\rm  tooth}$) for \texttt  {Cantor-N2-HybridRZ}, \texttt  {Compact-N2}, and best-performing \texttt  {F3-111}.}}{40}{table.ext.4}\protected@file@percent }
\newlabel{tab:nems_feasibility}{{4}{40}{\textbf {Room-temperature ($T = \NatureRotCeightCompactNtwoCdToleranceTemperatureK {}\text { K}$) NEMS mechanical feasibility, discretization-bounded pull-in thresholds, multi-regime $\text {Si}\langle 110\rangle $ flexure stroke scaling, and lithographic tolerances in vacuum ($\varepsilon _{\rm bg}=1.0$).} Comparison of thermal Matsubara dispersion, capacitance-gradient patch-voltage thresholds $V_{\rm crit}$, four-spoke single-crystal $\text {Si}\langle 110\rangle $ suspension designs ($E_Y = \scinum {\NatureRotCeightCompactNtwoLateralStabilityEYPa }\text { Pa}$) across three operational stroke regimes bounded across (a) Standard sharp-edge BEM ($N_{\rm panels}=\RotCfourTightslotNtwoStandardThetaZerozerosixpzeroPanelCount {}$ for $N=2$; $6{,}784$ for \texttt {F3-111}), (b) $r_{\rm edge}=5\text { nm}$ rounded-edge BEM ($N_{\rm panels}=\RotCfourTightslotNtwoUltraHighThetaZerozerosixpzeroPanelCount {}$ Ultra-High for $N=2$; Standard per-sub-tooth density for \texttt {F3-111}), and (c) continuum-extrapolated ($N_{\rm panels}\to \infty $) forces, plus EBL corner rounding ($r_{\rm edge}$) and critical-dimension tooth-width biases ($\Delta w_{\rm tooth}$) for \texttt {Cantor-N2-HybridRZ}, \texttt {Compact-N2}, and best-performing \texttt {F3-111}}{table.ext.4}{}}
