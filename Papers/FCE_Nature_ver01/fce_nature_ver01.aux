\newlabel{fig:all_constellations_blender}{{1}{22}{\textbf {Complete 3D Blender constellation atlas across all 12 evaluated geometries in true vacuum ($\varepsilon _{\rm bg}=1.0$).} \textbf {Top}, Side-by-side 3D perspective lineup of all 12 constellations (from $N=0$ overhang and flush single-tooth baselines to $N=1$, non-fractal controls \texttt {Ctrl\_SingleWide}, \texttt {Ctrl\_UniformPeriodic}, and \texttt {Ctrl\_SizeMatched\_Monotonic}, $N=2$ flat-$z$ and $(r,z)$-scaled Cantor rings, compact NEMS variants \texttt {Rot\_C8\_Compact\_N2} and \texttt {Rot\_C4\_TightSlot\_N2}, $N=3$ 7-track Cantor ring, and full-monolithic $N=2$ and $N=3$ structural assemblies). \textbf {Middle}, Individual $3\times 4$ 3D cutaway portraits annotated with radial coordinates, track counts, and disengaged ($\theta =3^\circ \text {--}6^\circ $) vs.\ engaged ($\theta =48^\circ $) axial Casimir forces. \textbf {Bottom}, Apples-to-apples Standard-mesh 3D BEM and 4-pass $R=50$ 3D FDTD Meep force progression across all 12 constellations}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Rotational quantum-clutch architecture and six-step physical narrative in true vacuum ($\varepsilon _{\rm  bg}=1.0$).} \textbf  {Top}, 3D rendered architecture illustrating the interdigitated concentric Gold rotor teeth, slotted Cantor stator rings, recessed landing pads, and $\text  {Si}\langle 110\rangle $ flexure suspension across repulsive, straddling, and attractive rotational states. \textbf  {Bottom}, Six-step verification progressing from (\textbf  {A}) single-tooth vertical interdigitation and overhang sign reversal ($N=0$) and (\textbf  {B}) single-track angular switching to (\textbf  {C}) Cantor generation scaling ($N=0 \to 3$), (\textbf  {D}, \textbf  {E}) prefractal Cantor hierarchies versus matched non-fractal controls (\texttt  {Ctrl\_SingleWide}, \texttt  {Ctrl\_UniformPeriodic}, and \texttt  {Ctrl\_SizeMatched\_Monotonic}), and (\textbf  {F}) full-monolithic support and multi-resolution BEM/MEEP convergence.}}{23}{figure.caption.6}\protected@file@percent }
\newlabel{fig:quantum_clutch_architecture_and_narrative}{{2}{23}{\textbf {Rotational quantum-clutch architecture and six-step physical narrative in true vacuum ($\varepsilon _{\rm bg}=1.0$).} \textbf {Top}, 3D rendered architecture illustrating the interdigitated concentric Gold rotor teeth, slotted Cantor stator rings, recessed landing pads, and $\text {Si}\langle 110\rangle $ flexure suspension across repulsive, straddling, and attractive rotational states. \textbf {Bottom}, Six-step verification progressing from (\textbf {A}) single-tooth vertical interdigitation and overhang sign reversal ($N=0$) and (\textbf {B}) single-track angular switching to (\textbf {C}) Cantor generation scaling ($N=0 \to 3$), (\textbf {D}, \textbf {E}) prefractal Cantor hierarchies versus matched non-fractal controls (\texttt {Ctrl\_SingleWide}, \texttt {Ctrl\_UniformPeriodic}, and \texttt {Ctrl\_SizeMatched\_Monotonic}), and (\textbf {F}) full-monolithic support and multi-resolution BEM/MEEP convergence}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Independent three-solver verification of the rotational quantum clutch in true vacuum ($\varepsilon _{\rm  bg}=1.0$).} Comparison of axial Casimir force benchmarks and boundary-element continuum extrapolations across \texttt  {Standard}, \texttt  {High}, and \texttt  {Ultra\_High} panel discretizations in 3D Vector-Dyadic BEM and 3D Scalar-Yukawa BEM alongside 4-pass inclusion--exclusion 3D FDTD MEEP simulations on BigRed 200 and 1D Lifshitz--PFA.}}{24}{figure.caption.7}\protected@file@percent }
\newlabel{fig:quantum_clutch_3solver_verification}{{3}{24}{\textbf {Independent three-solver verification of the rotational quantum clutch in true vacuum ($\varepsilon _{\rm bg}=1.0$).} Comparison of axial Casimir force benchmarks and boundary-element continuum extrapolations across \texttt {Standard}, \texttt {High}, and \texttt {Ultra\_High} panel discretizations in 3D Vector-Dyadic BEM and 3D Scalar-Yukawa BEM alongside 4-pass inclusion--exclusion 3D FDTD MEEP simulations on BigRed 200 and 1D Lifshitz--PFA}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {NEMS feasibility and stability assessment for the rotational quantum clutch in true vacuum ($\varepsilon _{\rm  bg}=1.0$) at $T=300{}\text  { K}$.} The four-panel benchmark quantifies (\textbf  {1}) room-temperature Matsubara dispersion across PEC ($0\text  { K}$), Gold ($0\text  { K}$), and Gold ($300\text  { K}$); (\textbf  {2}) net repulsive restoring force under uncompensated electrostatic bias and patch voltages ($V_{\rm  crit}$); (\textbf  {3}) radial Casimir stiffness versus the 4-spoke $\text  {Si}\langle 110\rangle $ mechanical flexure suspension stiffness; and (\textbf  {4}) repulsive lift and switching swing across lithographic critical-dimension ($\Delta \text  {CD}$) tooth-width etch tolerances.}}{25}{figure.caption.14}\protected@file@percent }
\newlabel{fig:nature_feasibility_stability}{{4}{25}{\textbf {NEMS feasibility and stability assessment for the rotational quantum clutch in true vacuum ($\varepsilon _{\rm bg}=1.0$) at $T=\NatureRotCeightCompactNtwoCdToleranceTemperatureK {}\text { K}$.} The four-panel benchmark quantifies (\textbf {1}) room-temperature Matsubara dispersion across PEC ($0\text { K}$), Gold ($0\text { K}$), and Gold ($300\text { K}$); (\textbf {2}) net repulsive restoring force under uncompensated electrostatic bias and patch voltages ($V_{\rm crit}$); (\textbf {3}) radial Casimir stiffness versus the 4-spoke $\text {Si}\langle 110\rangle $ mechanical flexure suspension stiffness; and (\textbf {4}) repulsive lift and switching swing across lithographic critical-dimension ($\Delta \text {CD}$) tooth-width etch tolerances}{figure.caption.14}{}}
